{
  "name": "sonos-streamdeck",
  "version": "0.1.0",
  "private": true,
  "description": "Stream Deck plugin for Sonos: play/pause, group and volume keys for speakers picked in the action settings",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.igorstefus.sonos\"",
    "assets": "python tools/make-assets.py",
    "link": "streamdeck link com.igorstefus.sonos.sdPlugin",
    "restart": "streamdeck restart com.igorstefus.sonos",
    "validate": "streamdeck validate com.igorstefus.sonos.sdPlugin",
    "pack": "streamdeck pack com.igorstefus.sonos.sdPlugin"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.3"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "28.0.6",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.1",
    "@rollup/plugin-typescript": "12.1.4",
    "@types/node": "20.19.0",
    "rollup": "4.46.2",
    "tslib": "2.8.1",
    "typescript": "5.9.2"
  }
}
